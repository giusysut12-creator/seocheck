# Frontend (Vite) — safe to expose in the browser bundle.
# Get these from your Supabase project settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The variables below are SERVER-SIDE ONLY. Do not add a VITE_ prefix to
# them and never put them in this frontend env file for real values — set
# them as Supabase Edge Function secrets instead:
#
#   supabase secrets set SEO_API_URL=https://api.your-seo-provider.com
#   supabase secrets set SEO_API_KEY=sk_live_xxxxx
#   supabase secrets set AI_API_KEY=sk-ant-xxxxx
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into every Edge Function by Supabase — you do not set them.
# ---------------------------------------------------------------------------

# SEO data provider (keywords, rankings, competitors, backlinks, traffic).
# Leave unset to run with the Site Audit crawler only — the UI will clearly
# show "SEO data provider not connected" instead of fake numbers.
# SEO_API_URL=https://api.your-seo-provider.com
# SEO_API_KEY=

# AI SEO Assistant (Anthropic Messages API). Leave unset to disable the
# assistant — the UI will show "AI assistant not configured".
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Google Search Console (free, real data for sites you own)
#
#   supabase secrets set GOOGLE_CLIENT_ID=...apps.googleusercontent.com
#   supabase secrets set GOOGLE_CLIENT_SECRET=...
#
# In Google Cloud Console: create a project, enable the "Google Search Console
# API", then create an OAuth 2.0 Client ID of type "Web application" whose
# authorized redirect URI is exactly:
#   https://<your-project-ref>.supabase.co/functions/v1/google-oauth-callback
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Ads (optional) — adds search volume, CPC and competition.
#
# Needs more than OAuth: a developer token approved by Google (requested from
# a Google Ads manager account; Basic access requires an application) plus the
# Ads customer ID to query against. Without these the app says Google Ads is
# not connected rather than guessing volumes.
# ---------------------------------------------------------------------------
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=            # e.g. 1234567890 (dashes are stripped)
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=      # manager account, when applicable
# GOOGLE_ADS_API_VERSION=v18         # override when your version is retired
# GOOGLE_ADS_CACHE_TTL_DAYS=30       # how long cached metrics stay fresh
