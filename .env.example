# Frontend (Vite) — safe to expose in the browser bundle.
# Get these from your Supabase project settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# The variables below are SERVER-SIDE ONLY. Do not add a VITE_ prefix to
# them and never put them in this frontend env file for real values — set
# them as Supabase Edge Function secrets instead:
#
#   supabase secrets set SEO_API_URL=https://api.your-seo-provider.com
#   supabase secrets set SEO_API_KEY=sk_live_xxxxx
#   supabase secrets set AI_API_KEY=sk-ant-xxxxx
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into every Edge Function by Supabase — you do not set them.
# ---------------------------------------------------------------------------

# SEO data provider (keywords, rankings, competitors, backlinks, traffic).
# Leave unset to run with the Site Audit crawler only — the UI will clearly
# show "SEO data provider not connected" instead of fake numbers.
# SEO_API_URL=https://api.your-seo-provider.com
# SEO_API_KEY=

# AI SEO Assistant (Anthropic Messages API). Leave unset to disable the
# assistant — the UI will show "AI assistant not configured".
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-5
